<Window x:Class="ClickRun.UI.Views.HotKeySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改热键"
        Height="260" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CaptureBorder}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="修改热键"
                   Style="{DynamicResource H2Style}"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="请直接按下新的热键组合"
                   Style="{DynamicResource CaptionStyle}"
                   Margin="0,0,0,12" />

        <!-- 捕获预览区 -->
        <Border Grid.Row="2" x:Name="CaptureBorder"
                Background="{DynamicResource InkBrush}"
                Padding="16,14"
                CornerRadius="3"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding PreviewText}"
                       FontFamily="{DynamicResource MonoFont}"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 说明 -->
        <TextBlock Grid.Row="3"
                   Text="支持 F1-F12 / 字母 / 数字，可配合 Ctrl / Alt / Shift"
                   Style="{DynamicResource CaptionStyle}" />
        <TextBlock Grid.Row="4"
                   Text="Esc 取消"
                   Style="{DynamicResource CaptionStyle}"
                   Margin="0,4,0,0" />

        <!-- 当前选择和按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="当前: "
                       VerticalAlignment="Center"
                       Style="{DynamicResource CaptionStyle}"
                       Margin="0,0,8,0" />
            <TextBlock Text="{Binding CurrentHotKeyName}"
                       VerticalAlignment="Center"
                       Style="{DynamicResource DataStyle}"
                       Margin="0,0,16,0" />
            <Button Content="确定"
                    Style="{DynamicResource SecondaryButton}"
                    IsEnabled="{Binding IsConfirmEnabled}"
                    Click="Confirm_Click"
                    Margin="0,0,8,0" />
            <Button Content="取消"
                    Style="{DynamicResource SecondaryButton}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
